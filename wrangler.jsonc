{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // PRODUCTION. Same Cloudflare account as staging (aura-official, owns the
  // printwithaura.com zone) but every resource is separate. scripts/cf-guard.mjs
  // refuses to run against this file if any binding points at a staging resource.
  "name": "aura-dynamics",
  "account_id": "f388d9461c4f6f9f1efa0145c1f6eb47",
  // Serve production only on its custom domain; *.workers.dev and preview URLs
  // would bypass custom-domain WAF/rate-limit rules.
  "workers_dev": false,
  "preview_urls": false,

  // PRE-LAUNCH phase: only the unlinked check hostname. The Coming Soon Worker
  // (shrill-tree-d4d5) keeps printwithaura.com. Pre-launch builds are noindex,
  // email goes to EMAIL_ALLOWLIST only, and links use launch-check. The cutover
  // to printwithaura.com + www is a separate reviewed PR; cf-guard checks that
  // routes, vars and the package.json build env agree on the phase
  // (see docs/releases/production-setup-plan.md).
  "routes": [{ "pattern": "launch-check.printwithaura.com", "custom_domain": true }],

  "compatibility_date": "2025-08-15",

  "compatibility_flags": [
    // Enable Node.js APIs.
    "nodejs_compat",

    // Allow fetch requests to public URLs.
    "global_fetch_strictly_public",
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "d1_databases": [
    {
      "binding": "D1",
      // PLACEHOLDER: the old, empty aura-personal database id. Kept only because
      // local dev state is keyed on it. Replace with the id printed by
      // `wrangler d1 create aura-production` (provisioning step 2); cf-guard
      // refuses to migrate or deploy while this placeholder is present.
      "database_id": "ca5f1a51-2974-4a83-99a1-6392ac4e2379",
      "database_name": "aura-production",
    },
  ],

  "services": [],

  // Namespace IDs are account-wide: staging uses 1001/1002, so production must
  // not, or both environments would share one counter.
  "ratelimits": [
    { "name": "CHECKOUT_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
  ],

  "vars": {
    "CLOUDFLARE_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://launch-check.printwithaura.com",
  },

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "aura-media-production",
    },
  ],
}
