{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "aura-dynamics",

  "compatibility_date": "2025-08-15",

  "compatibility_flags": [
    // Enable Node.js APIs.
    "nodejs_compat",

    // Allow fetch requests to public URLs.
    "global_fetch_strictly_public",
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "ca5f1a51-2974-4a83-99a1-6392ac4e2379",
      "database_name": "aura-production",
    },
  ],

  "services": [
    // Self-reference can be configured later if OpenNext requires it.
    //
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "aura-dynamics",
    // },
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "aura-media",
    },

    // Optional OpenNext incremental-cache bucket.
    //
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Additional environments can be configured later.
  //
  // Example:
  //
  // "env": {
  //   "staging": {
  //     "name": "aura-dynamics-staging",
  //
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "<STAGING_DATABASE_ID>",
  //         "database_name": "aura-staging",
  //       },
  //     ],
  //
  //     "services": [
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "aura-dynamics-staging",
  //       // },
  //     ],
  //
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "aura-media-staging",
  //       },
  //     ],
  //   },
  // },
}